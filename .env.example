# Copy to .env.local (git-ignored). Values come from the Neon project lol-market-db.
# Read-only role (web_reader), pooled endpoint. Used by api/ (also set in Vercel).
DATABASE_URL=postgresql://web_reader:<password>@<endpoint>-pooler.<region>.aws.neon.tech/lol_market?sslmode=require
# Read/write owner role. Used by the ingestor (GitHub secret INGESTOR_DATABASE_URL in ingest.yml).
INGESTOR_DATABASE_URL=postgresql://lol_market_owner:<password>@<endpoint>.<region>.aws.neon.tech/lol_market?sslmode=require
