{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @lol/web build",
  "devCommand": "pnpm --filter @lol/web dev --port $PORT",
  "outputDirectory": "web/dist",
  "trailingSlash": false,
  "functions": {
    "api/og.ts": {
      "includeFiles": "{api/_fonts/**,node_modules/.pnpm/@resvg+resvg-wasm@*/node_modules/@resvg/resvg-wasm/index_bg.wasm,node_modules/.pnpm/harfbuzzjs@*/node_modules/harfbuzzjs/hb.wasm}"
    }
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/([tT][eE][aA][mM][sS])/:name",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|Discordbot|Slackbot|facebookexternalhit|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|redditbot|Embedly|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share?team=:name"
    },
    {
      "source": "/([pP][lL][aA][yY][eE][rR][sS])/:name",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|Discordbot|Slackbot|facebookexternalhit|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|redditbot|Embedly|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share?player=:name"
    },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/credits", "destination": "/index.html" },
    { "source": "/([cC][oO][mM][pP][aA][rR][eE])", "destination": "/index.html" },
    { "source": "/([fF][eE][eE][dD])", "destination": "/index.html" },
    { "source": "/([rR][uU][mM][oO][rR][sS])", "destination": "/index.html" },
    { "source": "/([rR][uU][mM][oO][rR][sS])/([nN][eE][wW])", "destination": "/index.html" },
    { "source": "/([tT][eE][aA][mM][sS])/:name", "destination": "/index.html" },
    { "source": "/([pP][lL][aA][yY][eE][rR][sS])/:name", "destination": "/index.html" }
  ]
}
